FROM mambaorg/micromamba:2.0.5

WORKDIR /workspace

# Recreate the exact software stack from lock files.
COPY repro/locks/environment-smn.yml /tmp/environment-smn.yml
COPY repro/locks/pip-freeze-smn.txt /tmp/pip-freeze-smn.txt

RUN micromamba create -y -n smn -f /tmp/environment-smn.yml && \
    micromamba run -n smn python -m pip install --no-deps -r /tmp/pip-freeze-smn.txt && \
    micromamba clean -a -y

SHELL ["/usr/local/bin/_dockerfile_shell.sh"]
ENV MAMBA_DOCKERFILE_ACTIVATE=1

CMD ["python", "--version"]
